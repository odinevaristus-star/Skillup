
{
  "comment": "FORCE RULES UPDATE: Allowing public read access to the 'users' collection for unauthenticated freelancer browsing. Ensuring all other collections remain authenticated. Simplified queries to avoid composite index requirements.",
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Details about a SkillUp user, including their role and professional details.",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "title": { "type": "string" },
        "bio": { "type": "string" },
        "department": { "type": "string" },
        "priceRange": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "roles": { "type": "array", "items": { "type": "string" }, "description": "List of roles enabled for this user" },
        "activeRole": { "type": "string", "enum": ["client", "freelancer"], "description": "The currently active mode for the user" },
        "skillType": { "type": "string", "enum": ["Digital", "Artisan"] },
        "avatarUrl": { "type": "string" },
        "rating": { "type": "number" },
        "completedJobs": { "type": "number" },
        "isAvailable": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "activeRole", "email"]
    },
    "Job": {
      "title": "Job",
      "description": "A job posting or project on the platform.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "budget": { "type": "number" },
        "category": { "type": "string" },
        "skillsRequired": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["open", "in-progress", "completed", "cancelled"] },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "freelancerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "deadline": { "type": "string" }
      },
      "required": ["title", "clientId", "status"]
    },
    "JobApplication": {
      "title": "Job Application",
      "description": "An application for a job post.",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "freelancerId": { "type": "string" },
        "freelancerName": { "type": "string" },
        "coverLetter": { "type": "string" },
        "bidAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["jobId", "freelancerId", "status"]
    },
    "Message": {
      "title": "Message",
      "description": "A message sent between users.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" },
        "chatId": { "type": "string" }
      },
      "required": ["senderId", "receiverId", "text", "timestamp", "chatId"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A system notification for a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "link": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "read", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "google", "github"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Public professional profiles. Anyone can read, only owners can write."
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Job postings. Authenticated users can read and write."
    },
    "/applications/{applicationId}": {
      "schema": "JobApplication",
      "description": "Job applications. Authenticated users can read and write."
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Peer-to-peer messages. Participants can read and write."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications. Owners can read and write."
    }
  }
}
