
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Details about a SkillUp user, including their role and professional details.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "The user's full name."
        },
        "email": {
          "type": "string",
          "description": "The user's email address."
        },
        "title": {
          "type": "string",
          "description": "Professional title (e.g., Senior Full Stack Engineer)."
        },
        "bio": {
          "type": "string",
          "description": "A short professional biography."
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "A list of skills the user possesses."
        },
        "role": {
          "type": "string",
          "enum": ["customer", "freelancer"],
          "description": "The user's primary role on the platform."
        },
        "avatarUrl": {
          "type": "string",
          "description": "URL to the user's profile picture."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the profile was created."
        }
      },
      "required": ["fullName", "role", "email"]
    },
    "Job": {
      "title": "Job",
      "description": "A job posting or project on the platform.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "budget": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in-progress", "completed"] },
        "clientId": { "type": "string" },
        "freelancerId": { "type": "string" },
        "progress": { "type": "number" },
        "deadline": { "type": "string" }
      },
      "required": ["title", "clientId", "status"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "google",
      "github"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores the professional profile for each registered user."
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Stores details for each job posting."
    }
  }
}
